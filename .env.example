# All variables are server-side only. Never use VITE_* for credentials.
# Graph analysis and deterministic change-impact demo work without secrets.
# Optional least-privilege, public read-only GitHub token:
GITHUB_TOKEN=
# Optional live Jev (both secrets required). Configure through Vercel env add,
# or .env.local for local development; never commit credentials.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-1.14.0
# Generate a random value of at least 32 characters outside source control.
# Only the trusted operator uses this password in the live-analysis UI.
CHANGE_IMPACT_ACCESS_TOKEN=
