# Server-side settings only; never use VITE_* for secrets.
GITHUB_TOKEN=
# Local default when not on Vercel. Production MUST use a reachable HTTPS server.
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_MODEL=typed-decisions
# Optional locally; required for a remote Laya server. Shared with laya-serve.
LAYA_API_KEY=
# Independent private app password, at least 32 characters, for the live UI.
CHANGE_IMPACT_ACCESS_TOKEN=
# Optional runtime device selection: cpu or mps (automatic by default).
LAYA_DEVICE=
